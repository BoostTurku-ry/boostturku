# Copy to .env.local for development, and add the same values in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# Public URL of the site, used in sign-in links and emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API Keys). Create the project in an EU region (Stockholm).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: server only. Lets the forms write to the database. Never expose it.
SUPABASE_SECRET_KEY=sb_secret_...

# Resend (optional until set up). Without it, forms still save; no emails are sent.
RESEND_API_KEY=re_...
# Must be on a domain verified in Resend (boostturku.com).
EMAIL_FROM=Boost Turku <noreply@boostturku.com>
# Board inbox that gets a note about each new member and message.
NOTIFY_EMAIL=info@boostturku.com
# Weekly CSV backup of the member register (Mondays). Leave empty to skip.
BACKUP_EMAIL=

# Protects /api/cron/daily. Any long random string; Vercel Cron sends it automatically.
CRON_SECRET=
