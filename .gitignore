# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# cache (from the BoostTurku-ry repo template)
.cache
.eslintcache
.turbo
.swc

# Brand fonts under the Fontshare licence: downloaded at dev/build time by
# scripts/fetch-fonts.mjs, never committed (the licence restricts redistribution).
/src/assets/fonts/ClashDisplay-*.woff2
/src/assets/fonts/Switzer-*.woff2
